# Required in Vercel for durable accounts, sessions, reset codes and subscriptions.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Transactional email. The current provider integration is Resend.
EMAIL_PROVIDER_API_KEY=re_xxxxxxxxx
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Atmos Weather

# Stripe subscriptions. Price IDs are created in Stripe Dashboard.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_MONTHLY_PRICE_ID=price_xxxxxxxxx
STRIPE_YEARLY_PRICE_ID=price_xxxxxxxxx
